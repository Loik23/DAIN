<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>EchoCall</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>EchoCall</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	
	<!-- App Category -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.entertainment</string>
	
	<!-- Privacy Permissions -->
	<key>NSMicrophoneUsageDescription</key>
	<string>EchoCall needs microphone access to record and simulate realistic phone calls with AI voice generation.</string>
	<key>NSCameraUsageDescription</key>
	<string>EchoCall needs camera access to record videos of your fake call simulations for sharing on social media.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>EchoCall needs photo library access to save recordings and select contact photos for realistic call displays.</string>
	<key>NSContactsUsageDescription</key>
	<string>EchoCall can access your contacts to make fake calls appear more realistic with real contact information.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>EchoCall may use location to show realistic caller locations in fake call displays.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>EchoCall sends notifications to simulate incoming calls and provide app updates.</string>
	
	<!-- Audio Session -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>background-processing</string>
		<string>remote-notification</string>
	</array>
	
	<!-- Call Integration -->
	<key>INIntentsSupported</key>
	<array>
		<string>INStartCallIntent</string>
		<string>INStartAudioCallIntent</string>
	</array>
	
	<!-- App Transport Security -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
	
	<!-- Supported Interface Orientations -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	
	<!-- Status Bar -->
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	
	<!-- Launch Screen -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	
	<!-- App Icon -->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>Icon-App-20x20@1x</string>
				<string>Icon-App-20x20@2x</string>
				<string>Icon-App-20x20@3x</string>
				<string>Icon-App-29x29@1x</string>
				<string>Icon-App-29x29@2x</string>
				<string>Icon-App-29x29@3x</string>
				<string>Icon-App-40x40@1x</string>
				<string>Icon-App-40x40@2x</string>
				<string>Icon-App-40x40@3x</string>
				<string>Icon-App-60x60@2x</string>
				<string>Icon-App-60x60@3x</string>
				<string>Icon-App-76x76@1x</string>
				<string>Icon-App-76x76@2x</string>
				<string>Icon-App-83.5x83.5@2x</string>
				<string>Icon-App-1024x1024@1x</string>
			</array>
		</dict>
	</dict>
	
	<!-- Firebase -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<true/>
	
	<!-- URL Schemes -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>echocall.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>echocall</string>
			</array>
		</dict>
	</array>
	
	<!-- Scene Configuration -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	
	<!-- Minimum iOS Version -->
	<key>MinimumOSVersion</key>
	<string>12.0</string>
	
	<!-- Requires Full Screen -->
	<key>UIRequiresFullScreen</key>
	<true/>
	
	<!-- App Features -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	
</dict>
</plist>